---
import { getLangFromUrl, useTranslations } from "@/i18n/utils"
import BlogItem from "@/components/blog/BlogItem.astro"

const lang = getLangFromUrl(Astro.url)
const ui = useTranslations(lang)
---

<section class="pb-13 lg:pb-20 lg:container lg:mx-auto lg:px-3 lg:my-18">
  <h1 class="text-lg text-[#7B7B7B] uppercase py-5 text-center lg:text-left">{ui.blog.title}</h1>
  <div class="flex flex-col items-center justify-center gap-11 mx-auto lg:grid lg:grid-cols-3 lg:gap-2 lg:items-start">
    {
      ui.blog.entries.map((entry) => (
        <BlogItem title={entry.title} description={entry.description} image={entry.image} url={entry.url} openLabel={entry.open_label} />
      ))
    }
  </div>
</section>