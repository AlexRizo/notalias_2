---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import BlogItem from "@/components/blog/BlogItem.astro";

const lang = getLangFromUrl(Astro.url);
const ui = useTranslations(lang);
---

<section
  class="pb-13 lg:pb-20 lg:max-w-[1920px] lg:w-full lg:mx-auto lg:px-8 lg:my-18"
>
  <h1
    class="text-lg lg:text-xl text-[#7B7B7B] uppercase py-5 lg:pt-0 lg:pb-8 text-center lg:text-left"
  >
    {ui.blog.title}
  </h1>
  <div
    class="flex flex-col items-start justify-center gap-11 mx-auto lg:grid lg:grid-cols-3 lg:gap-4"
  >
    {
      ui.blog.entries.map((entry) => (
        <BlogItem
          title={entry.title}
          description={entry.description}
          image={entry.image}
          url={entry.url}
          openLabel={entry.open_label}
        />
      ))
    }
  </div>
</section>
