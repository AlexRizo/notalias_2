---
import { ContactForm } from "@/components/react/form/contact-form";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const ui = useTranslations(lang);
---

<section
  class="flex flex-col items-center justify-center pb-4 pt-10 lg:pb-18 lg:pt-20 bg-white"
>
  <h1
    class="text-3xl font-crimson text-center w-96 lg:text-6xl leading-none lg:w-130 lg:tracking-tight"
  >
    {ui.contact_page.title}
  </h1>
  <p class="text-lg text-center mt-6 lg:text-xl">
    {ui.contact_page.description}
  </p>
  <img src="/assets/icons/blue-ufo.svg" class="mt-12 mb-4 lg:w-43" />
</section>

<div class="pb-20 bg-white gray-background">
  <ContactForm client:load lang={lang} />
</div>