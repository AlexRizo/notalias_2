---
import Attributes from "@/components/interiors/Attributes.astro";
import OtherProyects from "@/components/interiors/OtherProyects.astro";
import { getInteriorContent } from "@/i18n/interiors";
import { getLangFromUrl } from "@/i18n/utils";
import { Icon } from "astro-icon/components";

const lang = getLangFromUrl(Astro.url);
const data = getInteriorContent("salar", lang)!;
---

<section class="custom-section px-2 interior">
  <div>
    <h1 class="title">SALAR</h1>

    <div class="relative h-54 lg:h-212 flex items-center justify-center rounded-md overflow-hidden">
      <Icon name="salar" class="h-5.5 w-80 lg:h-25 lg:w-166 absolute z-5" />
      <div class="size-full bg-black/20 absolute inset-0 z-3"></div>
      <img
        src="/assets/img/interiors/salar/media-01.webp"
        class="object-cover w-full h-full"
      />
    </div>
  </div>
  <article class="mt-4 lg:mt-26">
    <h2 class="description">{data.description}</h2>
    <Attributes attributes={data.attributes} />
  </article>

  <div class="content">
    <div class="img-container">
      <img
        src="/assets/img/interiors/salar/media-02.webp"
        class="h-91 lg:h-173 object-cover"
        loading="lazy"
      />
      <img
        src="/assets/img/interiors/salar/media-03.webp"
        class="h-91 lg:h-173 object-cover"
        loading="lazy"
      />
    </div>

    <article>
      <h3>Context</h3>
      <p class="p-02">
        {
          data.context.map((p, i) => (
            <>
              {i > 0 && (
                <>
                  <br />
                  <br />
                </>
              )}
              <span>{p}</span>
            </>
          ))
        }
      </p>
    </article>

    <img
      src="/assets/img/interiors/salar/media-04.webp"
      class="lg:h-192 object-cover"
      loading="lazy"
    />

    <article>
      <h3>Challenge</h3>
      <p>
        {
          data.challenge.map((p, i) => (
            <>
              {i > 0 && (
                <>
                  <br />
                  <br />
                </>
              )}
              <span>{p}</span>
            </>
          ))
        }
      </p>
    </article>

    <img
      src="/assets/img/interiors/salar/media-05.webp"
      loading="lazy"
      class="h-86 lg:h-200 object-cover object-center"
    />

    <article>
      <h3>The Work</h3>
      <div class="grid-p p-02">
        <p class="[&:not(:last-child)]:mb-6!">{data.the_work[0]}</p>
        <p class="[&:not(:last-child)]:mb-6!">
          {data.the_work[1]}
        </p>
      </div>
    </article>

    <img
      src="/assets/img/interiors/salar/media-06.webp"
      loading="lazy"
      class="h-86 lg:h-200 object-cover object-center"
    />
  </div>

  <OtherProyects currentSlug="salar" />
</section>
