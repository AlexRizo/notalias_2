---
import Attributes from "@/components/interiors/Attributes.astro";
import OtherProyects from "@/components/interiors/OtherProyects.astro";
import { getInteriorContent } from "@/i18n/interiors";
import { getLangFromUrl } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const data = getInteriorContent("swappp", lang)!;
---

<section class="max-w-96 mx-auto px-2 lg:container interior">
  <div>
    <h1 class="title">Swappp</h1>

    <img
      src="/assets/img/interiors/swappp/media-01.webp"
      class="h-54 lg:h-212 object-cover"
    />
  </div>

  <article class="mt-4 lg:mt-26">
    <h2 class="description">{data.description}</h2>
    <Attributes attributes={data.attributes} />
  </article>

  <div class="content">
    <div class="grid-component">
      <img
        src="/assets/img/interiors/swappp/media-02.webp"
        class="h-100 lg:h-180 object-cover"
      />
      <article>
        <h3>Context</h3>
        <p>
          {
            data.context.map((p, i) => (
              <>
                {i > 0 && (
                  <>
                    <br />
                    <br />
                  </>
                )}
                <span>{p}</span>
              </>
            ))
          }
        </p>
      </article>
    </div>

    <div class="grid-component">
      <video
        src="/assets/img/interiors/swappp/media-03.webm"
        playsinline
        muted
        autoplay
        loop
        preload="none"
        class="lg:h-180 object-cover lg:hidden"></video>
      <article>
        <h3>Challenge</h3>
        <p>
          {
            data.challenge.map((p, i) => (
              <>
                {i > 0 && (
                  <>
                    <br />
                    <br />
                  </>
                )}
                <span>{p}</span>
              </>
            ))
          }
        </p>
      </article>
      <video
        src="/assets/img/interiors/swappp/media-03.webm"
        playsinline
        muted
        autoplay
        loop
        preload="none"
        class="lg:h-180 object-cover hidden lg:block"></video>
    </div>

    <div class="grid-component">
      <img src="/assets/img/interiors/swappp/media-04.webp" loading="lazy" class="h-80 lg:h-auto object-cover"/>
      <article>
        <h3>The Work</h3>
        <p>
          <span>{data.the_work[0]}</span>
          <br /><br />
          <span>{data.the_work[1]}</span>
        </p>
      </article>
    </div>

    <div class="grid-component">
      <article>
        <p>
          <span>{data.the_work[2]}</span>
          <br /><br />
          <span>{data.the_work[3]}</span>
          <br /><br />
          <span>{data.the_work[4]}</span>
        </p>
      </article>
      <img src="/assets/img/interiors/swappp/media-05.webp" loading="lazy" />
    </div>
  </div>

  <OtherProyects prev_path="/" next_path="/" />
</section>
