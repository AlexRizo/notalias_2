---
import Attributes from "@/components/interiors/Attributes.astro";
import OtherProyects from "@/components/interiors/OtherProyects.astro";
import { getInteriorContent } from "@/i18n/interiors";
import { getLangFromUrl } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const data = getInteriorContent("tantan", lang)!;
---

<section class="max-w-96 mx-auto px-2 lg:container interior">
  <div>
    <h1 class="title">Tan Tán</h1>

    <img
      src="/assets/img/interiors/tantan/media-01.webp"
      class="h-54 lg:h-212 object-cover"
    />
  </div>

  <article class="mt-4 lg:mt-26">
    <h2 class="description">{data.description}</h2>
    <Attributes attributes={data.attributes} />
  </article>

  <div class="content">
    <img
      src="/assets/img/interiors/tantan/media-02.webp"
      class="h-50 lg:h-190 object-cover object-[0_62%]"
    />

    <video
      src="/assets/img/interiors/tantan/media-03.mp4"
      playsinline
      muted
      autoplay
      loop
      preload="none"
      class="lg:h-173 object-cover lg:hidden"></video>

    <article>
      <h3>Context</h3>
      <p class="p-02">
        {
          data.context.map((p, i) => (
            <>
              {i > 0 && (
                <>
                  <br />
                  <br />
                </>
              )}
              <span>{p}</span>
            </>
          ))
        }
      </p>
    </article>

    <div class="img-container">
      <video
        src="/assets/img/interiors/tantan/media-03.mp4"
        playsinline
        muted
        autoplay
        loop
        preload="none"
        class="h-173 object-cover hidden lg:block"></video>
      <img
        src="/assets/img/interiors/tantan/media-04.webp"
        loading="lazy"
        class="h-173 object-cover hidden lg:block"
      />
      <img
        src="/assets/img/interiors/tantan/media-05.webp"
        loading="lazy"
        class="h-106 lg:h-173 object-cover lg:hidden"
      />
    </div>

    <article>
      <h3>Challenge</h3>
      <p>
        {
          data.challenge.map((p, i) => (
            <>
              {i > 0 && (
                <>
                  <br />
                  <br />
                </>
              )}
              <span>{p}</span>
            </>
          ))
        }
      </p>
    </article>

    <img
      src="/assets/img/interiors/tantan/media-04.webp"
      loading="lazy"
      class="h-106 lg:h-173 object-cover lg:hidden"
    />

    <div class="img-container">
      <img
        src="/assets/img/interiors/tantan/media-05.webp"
        loading="lazy"
        class="h-173 object-cover hidden lg:block"
      />
      <img
        src="/assets/img/interiors/tantan/media-06.webp"
        loading="lazy"
        class="h-173 object-cover hidden lg:block"
      />
    </div>

    <article>
      <h3>The Work</h3>
      <div class="grid-p p-02">
        <p>{data.the_work[0]}</p>
      </div>
    </article>

    <img src="/assets/img/interiors/tantan/media-07.webp" loading="lazy" />
    <img
      src="/assets/img/interiors/tantan/media-06.webp"
      loading="lazy"
      class="h-80 lg:h-173 object-cover lg:hidden"
    />
  </div>

  <OtherProyects prev_path="/" next_path="/" />
</section>
