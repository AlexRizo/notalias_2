---
import Attributes from "@/components/interiors/Attributes.astro";
import OtherProyects from "@/components/interiors/OtherProyects.astro";
import { getInteriorContent } from "@/i18n/interiors";
import { getLangFromUrl } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const data = getInteriorContent("strategyos", lang)!;
---

<section class="max-w-96 mx-auto px-2 lg:container interior">
  <div>
    <h1 class="title">Strategy OS</h1>

    <img
      src="/assets/img/interiors/strategyos/media-01.webp"
      class="h-54 lg:h-212 object-cover"
    />
  </div>
  <article class="mt-4 lg:mt-26">
    <h2 class="description">{data.description}</h2>
    <Attributes attributes={data.attributes} />
  </article>

  <div class="content">
    <div class="grid-component">
      <img
        src="/assets/img/interiors/strategyos/media-02.webp"
        class="h-91 lg:h-200 object-cover"
        loading="lazy"
      />
      <article class="">
        <h3>Context</h3>
        <p>
          {
            data.context.map((p, i) => (
              <>
                {i > 0 && (
                  <>
                    <br />
                    <br />
                  </>
                )}
                <span>{p}</span>
              </>
            ))
          }
        </p>
      </article>
      <img
        src="/assets/img/interiors/strategyos/media-03.webp"
        class="h-86 lg:h-200 object-cover object-center lg:hidden"
      />
    </div>


    <div class="grid-component">
      <article>
        <h3>Challenge</h3>
        <p>
          {
            data.challenge.map((p, i) => (
              <>
                {i > 0 && (
                  <>
                    <br />
                    <br />
                  </>
                )}
                <span>{p}</span>
              </>
            ))
          }
        </p>
      </article>
      <img
        src="/assets/img/interiors/strategyos/media-03.webp"
        class="h-86 lg:h-200 object-cover object-center hidden lg:block"
      />
    </div>

    <img
      src="/assets/img/interiors/strategyos/media-04.webp"
      loading="lazy"
      class="lg:h-188 object-cover object-[0_60%]"
    />

    <article>
      <h3>The Work</h3>
      <div class="grid-p p-02">
        <p>{data.the_work[0]}</p>
      </div>
    </article>

    <img
      src="/assets/img/interiors/strategyos/media-05.webp"
      loading="lazy"
      class="lg:h-188 object-cover object-[0_60%]"
    />
  </div>

  <OtherProyects prev_path="/" next_path="/" />
</section>
