---
import Attributes from "@/components/interiors/Attributes.astro";
import OtherProyects from "@/components/interiors/OtherProyects.astro";
import { getInteriorContent } from "@/i18n/interiors";
import { getLangFromUrl } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const data = getInteriorContent("eterno-centinela", lang)!;
---

<section class="max-w-96 mx-auto px-2 lg:container interior">
  <div>
    <h1 class="title">Eterno Centinela</h1>

    <img
      src="/assets/img/interiors/eterno-centinela/media-01.webp"
      class="h-54 lg:h-212 object-cover"
    />
  </div>
  <article class="mt-4 lg:mt-26">
    <h2 class="description">{data.description}</h2>
    <Attributes attributes={data.attributes} />
  </article>

  <div class="content">
    <div class="img-container">
      <video
        src="/assets/img/interiors/eterno-centinela/media-02.webm"
        playsinline
        muted
        autoplay
        loop
        class="lg:h-212 object-cover hidden lg:block"
        preload="none"></video>

      <img
        src="/assets/img/interiors/eterno-centinela/media-03.webp"
        class="h-111 lg:h-212 object-cover"
        loading="lazy"
      />
    </div>

    <article>
      <h3>Context</h3>
      <p>
        {data.context.map((p, i) => (
          <>
            {i > 0 && <><br /><br /></>}
            <span>{p}</span>
          </>
        ))}
      </p>
    </article>

    <video
      src="/assets/img/interiors/eterno-centinela/media-02.webm"
      playsinline
      muted
      autoplay
      loop
      class="object-cover lg:hidden"
      preload="none"></video>

    <img
      src="/assets/img/interiors/eterno-centinela/media-04.webp"
      loading="lazy"
    />

    <article>
      <h3>Challenge</h3>
      <p>
        {data.challenge.map((p, i) => (
          <>
            {i > 0 && <><br /><br /></>}
            <span>{p}</span>
          </>
        ))}
      </p>
    </article>

    <div class="img-container">
      <img
        src="/assets/img/interiors/eterno-centinela/media-05.webp"
        class="lg:h-212 object-cover"
        loading="lazy"
      />
      <img
        src="/assets/img/interiors/eterno-centinela/media-06.webp"
        class="h-176.5 lg:h-212 object-cover hidden lg:block"
        loading="lazy"
      />
    </div>

    <article>
      <h3>The Work</h3>
      <p>
        {
          data.the_work.map((p, i) => (
            <>
              {i > 0 && (
                <>
                  <br />
                  <br />
                </>
              )}
              <span>{p}</span>
            </>
          ))
        }
      </p>
    </article>

    <img
      src="/assets/img/interiors/eterno-centinela/media-06.webp"
      class="h-176.5 object-cover lg:hidden"
      loading="lazy"
    />

    <img
      src="/assets/img/interiors/eterno-centinela/media-07.webp"
      loading="lazy"
    />
  </div>

  <OtherProyects prev_path="/" next_path="/" />
</section>
