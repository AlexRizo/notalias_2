---
import Attributes from "@/components/interiors/Attributes.astro";
import OtherProyects from "@/components/interiors/OtherProyects.astro";
import { getInteriorContent } from "@/i18n/interiors";
import { getLangFromUrl } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const data = getInteriorContent("flor-y-fruto", lang)!;
---

<section class="max-w-96 mx-auto px-2 lg:container interior">
  <div>
    <h1 class="title">Flor y Fruto</h1>

    <div class="relative flex items-center justify-center">
      <video
        src="/assets/img/interiors/flor-y-fruto/media-01.mp4"
        playsinline
        muted
        autoplay
        loop
        class="h-54 lg:h-212 object-cover"
        preload="none"></video>
      <img
        src="/assets/img/interiors/flor-y-fruto/video-icon.webp"
        class="absolute w-26! lg:w-112.5!"
      />
    </div>
  </div>
  <article class="mt-4 lg:mt-26">
    <h2 class="description">{data.description}</h2>
    <Attributes attributes={data.attributes} />
  </article>

  <div class="content">
    <div class="img-container">
      <img
        src="/assets/img/interiors/flor-y-fruto/media-02.webp"
        class="lg:h-[687px] object-cover object-top"
        loading="lazy"
      />

      <img
        src="/assets/img/interiors/flor-y-fruto/media-03.webp"
        loading="lazy"
        class="lg:h-[687px] object-cover"
      />
    </div>

    <article>
      <h3>Context</h3>
      <p class="p-02">
        {
          data.context.map((p, i) => (
            <>
              {i > 0 && (
                <>
                  <br />
                  <br />
                </>
              )}
              <span>{p}</span>
            </>
          ))
        }
      </p>
    </article>

    <img
      src="/assets/img/interiors/flor-y-fruto/media-04.webp"
      loading="lazy"
    />

    <div class="grid-component">
      <article>
        <h3>Challenge</h3>
        <p>
          {
            data.challenge.map((p, i) => (
              <>
                {i > 0 && (
                  <>
                    <br />
                    <br />
                  </>
                )}
                <span>{p}</span>
              </>
            ))
          }
        </p>
      </article>

      <img
        src="/assets/img/interiors/flor-y-fruto/media-05.webp"
        loading="lazy"
        class="lg:h-200 object-cover object-[0_25%]"
      />
    </div>

    <div class="img-container">
      <img
        src="/assets/img/interiors/flor-y-fruto/media-06.webp"
        loading="lazy"
        class="lg:h-[687px] object-cover"
      />
      <img
        src="/assets/img/interiors/flor-y-fruto/media-07.webp"
        loading="lazy"
        class="h-114 lg:h-[687px] object-cover object-[0_35%]"
      />
    </div>

    <article>
      <h3>The Work</h3>
      <div class="lg:flex lg:flex-row lg:gap-4 p-02 mx-auto">
        <p class="text-left! flex-1">
          <span>{data.the_work[0]}<br /><br /></span>
          <span>{data.the_work[1]}<br /><br /></span>
        </p>
        <p class="text-left! flex-1">
          <span>{data.the_work[2]}<br /><br /></span>
          <span>{data.the_work[3]}</span>
        </p>
      </div>
    </article>
  </div>

  <OtherProyects prev_path="/" next_path="/" />
</section>
