---
import Attributes from "@/components/interiors/Attributes.astro";
import OtherProyects from "@/components/interiors/OtherProyects.astro";
import { getInteriorContent } from "@/i18n/interiors";
import { getLangFromUrl } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const data = getInteriorContent("nonstop", lang)!;
---

<section class="max-w-96 mx-auto px-2 lg:container interior">
  <div>
    <h1 class="title">Nonstop</h1>

    <video
      src="/assets/img/interiors/nonstop/media-01.webm"
      playsinline
      muted
      autoplay
      loop
      class="h-54 lg:h-212 object-cover"
      preload="none"></video>
  </div>
  <article class="mt-4 lg:mt-26">
    <h2 class="description">{data.description}</h2>
    <Attributes attributes={data.attributes} />
  </article>

  <div class="content">
    <div class="flex items-center justify-center relative">
      <img
        src="/assets/img/interiors/nonstop/media-02.webp"
        class="h-114 lg:h-208 object-cover"
        loading="lazy"
      />
      <img
        src="/assets/img/interiors/nonstop/bars.webp"
        class="absolute translate-x-16 lg:h-176! w-auto! h-86! lg:translate-x-32"
      />
      <img
        src="/assets/img/interiors/nonstop/bars.webp"
        class="absolute -translate-x-16 lg:h-176! w-auto! h-86! lg:-translate-x-32"
      />
    </div>

    <article>
      <h3>Context</h3>
      <p class="p-02">
        {
          data.context.map((p, i) => (
            <>
              {i > 0 && (
                <>
                  <br />
                  <br />
                </>
              )}
              <span>{p}</span>
            </>
          ))
        }
      </p>
    </article>

    <div class="grid-component">
      <video
        src="/assets/img/interiors/nonstop/media-03.webm"
        autoplay
        muted
        loop
        class="h-111 lg:h-200 object-cover"
        playsinline></video>
      <img
        src="/assets/img/interiors/nonstop/media-04.webp"
        class="lg:h-213.5 object-cover object-[0_75%] lg:hidden"
        loading="lazy"
      />
      <article>
        <h3>Challenge</h3>
        <p>
          {
            data.challenge.map((p, i) => (
              <>
                {i > 0 && (
                  <>
                    <br />
                    <br />
                  </>
                )}
                <span>{p}</span>
              </>
            ))
          }
        </p>
      </article>
    </div>
    <img
      src="/assets/img/interiors/nonstop/media-04.webp"
      class="lg:h-213.5 object-cover object-[0_75%] hidden lg:block"
      loading="lazy"
    />

    <div class="grid-component">
      <img
        src="/assets/img/interiors/nonstop/media-05.webp"
        loading="lazy"
        class="h-91 lg:h-173 object-cover object-center"
      />

      <article>
        <h3>The Work</h3>
        <p>
          {
            data.the_work.map((p, i) => (
              <>
                {i > 0 && (
                  <>
                    <br />
                    <br />
                  </>
                )}
                <span>{p}</span>
                {i === 1 && (
                  <span class="lg:hidden">
                    <br />
                    <br />
                    <img
                      src="/assets/img/interiors/nonstop/media-06.webp"
                      class="lg:h-213.5 object-cover object-[0_75%]"
                      loading="lazy"
                    />
                  </span>
                )}
              </>
            ))
          }
        </p>
      </article>
    </div>
    <img
      src="/assets/img/interiors/nonstop/media-06.webp"
      class="lg:h-213.5 object-cover object-[0_75%] hidden lg:block"
      loading="lazy"
    />
  </div>

  <OtherProyects prev_path="/" next_path="/" />
</section>
