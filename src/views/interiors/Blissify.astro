---
import Attributes from "@/components/interiors/Attributes.astro";
import OtherProyects from "@/components/interiors/OtherProyects.astro";
import { getInteriorContent } from "@/i18n/interiors";
import { getLangFromUrl } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const data = getInteriorContent("blissify", lang)!;
---

<section class="max-w-96 mx-auto px-2 lg:container interior">
  <div>
    <h1 class="title">Blissify</h1>

    <video
      src="/assets/img/interiors/blissify/media-01.mp4"
      autoplay
      muted
      loop
      playsinline
      preload="none"
      class="h-54 lg:h-212 object-cover"></video>
  </div>

  <article class="mt-4 lg:mt-26">
    <h2 class="description">{data.description}</h2>
    <Attributes attributes={data.attributes} />
  </article>

  <div class="content">
    <div class="img-container">
      <video
        src="/assets/img/interiors/blissify/media-02.mp4"
        playsinline
        muted
        autoplay
        loop
        preload="none"></video>

      <img
        src="/assets/img/interiors/blissify/media-03.webp"
        loading="lazy"
        class="h-100 lg:h-auto object-cover"
      />
    </div>

    <article>
      <h3>Context</h3>
      <p class="p-02">
        {
          data.context.map((p, i) => (
            <>
              {i > 0 && (
                <>
                  <br />
                  <br />
                </>
              )}
              <span>{p}</span>
            </>
          ))
        }
      </p>
    </article>

    <div class="grid-component">
      <video
        src="/assets/img/interiors/blissify/media-04.mp4"
        playsinline
        muted
        autoplay
        loop
        preload="none"
        class="h-100 lg:h-180 object-cover object-center"></video>
      <article>
        <h3>Challenge</h3>
        <p>
          {
            data.challenge.map((p, i) => (
              <>
                {i > 0 && (
                  <>
                    <br />
                    <br />
                  </>
                )}
                <span>{p}</span>
              </>
            ))
          }
        </p>
      </article>
    </div>

    <div class="grid-component">
      <article>
        <h3>The Work</h3>
        <p>
          {
            data.the_work.map((p, i) => (
              <>
                {i > 0 && (
                  <>
                    <br />
                    <br />
                  </>
                )}
                <span>{p}</span>
              </>
            ))
          }
        </p>
      </article>

      <img
        src="/assets/img/interiors/blissify/media-06.webp"
        loading="lazy"
        class="h-90.5 lg:h-173 object-cover"
      />
    </div>

    <img
      src="/assets/img/interiors/blissify/media-05.webp"
      loading="lazy"
      class="h-[259px] lg:h-218 object-cover"
    />
  </div>

  <OtherProyects prev_path="/" next_path="/" />
</section>
