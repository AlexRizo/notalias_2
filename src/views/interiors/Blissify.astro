---
import Attributes from "@/components/interiors/Attributes.astro";
import OtherProyects from "@/components/interiors/OtherProyects.astro";
import type { Attributes as AttributesType } from "@/i18n/interiors";
import { getLangFromUrl } from "@/i18n/utils";

const attributes: AttributesType[] = [
  {
    label: "Client",
    value: ["BLISSIFY"],
  },
  {
    label: "Services",
    value: ["Brand Identity"],
  },
  {
    label: "Industry",
    value: ["E-commerce / Fashion & Lifestyle"],
  },
];

const lang = getLangFromUrl(Astro.url);
---

<section class="max-w-96 mx-auto px-2 lg:container interior">
  <div>
    <h1 class="title">Blissify</h1>

    <video
      src="/assets/img/interiors/blissify/media-01.mp4"
      autoplay
      muted
      loop
      playsinline
      preload="none"
      class="h-54 lg:h-212 object-cover"></video>
  </div>

  <article class="mt-4 lg:mt-26">
    <h2 class="description">
      Transformar el acceso a tendencias globales en una experiencia de marca.
    </h2>
    <Attributes attributes={attributes} />
  </article>

  <div class="content">
    <video
      src="/assets/img/interiors/blissify/media-02.mp4"
      playsinline
      muted
      autoplay
      loop
      preload="none"></video>

    <img
      src="/assets/img/interiors/blissify/media-03.webp"
      loading="lazy"
      class="h-100 lg:h-auto object-cover"
    />

    <article>
      <h3>Contexto</h3>
      <p>
        Blissify acerca tendencias globales a México a través de una experiencia
        de personal shopping. Moda, skincare, cosméticos, wellness y tecnología
        convivían dentro de una misma oferta, pero sin un sistema capaz de
        comunicarlo de manera consistente.
      </p>
    </article>

    <video
      src="/assets/img/interiors/blissify/media-04.mp4"
      playsinline
      muted
      autoplay
      loop
      preload="none"
      class="h-100 lg:h-auto object-cover object-center"></video>

    <article>
      <h3>Challenge</h3>
      <p>
        <span>El acceso ya no era el diferenciador. La percepción sí.</span>
        <br />
        <br />
        <span
          >La marca corría el riesgo de ser vista como una reventa informal en
          lugar de una plataforma confiable para descubrir productos y
          tendencias internacionales.</span
        >
      </p>
    </article>

    <img
      src="/assets/img/interiors/blissify/media-05.webp"
      loading="lazy"
      class="h-[259px] lg:h-auto object-cover"
    />

    <article>
      <h3>The Work</h3>
      <p>
        <span
          >Construimos una identidad editorial diseñada para ordenar la
          complejidad. Creamos un sistema visual capaz de integrar cinco
          categorías distintas bajo un mismo lenguaje, manteniendo claridad,
          coherencia y reconocimiento en cada punto de contacto.</span
        >
        <br />
        <br />
        <span
          >Más que una nueva imagen, desarrollamos una arquitectura de marca que
          permite crecer con consistencia. Una identidad con la formalidad de
          una empresa consolidada y la sensibilidad de un referente de
          tendencias.</span
        >
      </p>
    </article>

    <img
      src="/assets/img/interiors/blissify/media-06.webp"
      loading="lazy"
      class="h-90.5 lg:h-auto object-cover"
    />
  </div>

  <OtherProyects prev_path="/" next_path="/" />
</section>
