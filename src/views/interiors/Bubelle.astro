---
import Attributes from "@/components/interiors/Attributes.astro";
import OtherProyects from "@/components/interiors/OtherProyects.astro";
import { getInteriorContent } from "@/i18n/interiors";
import { getLangFromUrl } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const data = getInteriorContent("bubelle", lang)!;
---

<section class="max-w-96 mx-auto px-2 lg:container interior">
  <div>
    <h1 class="title">Bubelle</h1>

    <video
      src="/assets/img/interiors/bubelle/media-01.mp4"
      playsinline
      muted
      autoplay
      loop
      class="h-54 lg:h-212 object-cover"
      preload="none"></video>
  </div>
  <article class="mt-4 lg:mt-26">
    <h2 class="description">{data.description}</h2>
    <Attributes attributes={data.attributes} />
  </article>

  <div class="content">
    <img src="/assets/img/interiors/bubelle/media-02.webp" loading="lazy" />
    <video
      src="/assets/img/interiors/bubelle/media-03.mp4"
      playsinline
      muted
      autoplay
      loop
      class="lg:h-207 object-cover"
      preload="none"></video>

    <article>
      <h3>Context</h3>
      <p>
        {data.context.map((p, i) => (
          <>
            {i > 0 && <><br /><br /></>}
            <span>{p}</span>
          </>
        ))}
      </p>
    </article>

    <img src="/assets/img/interiors/bubelle/media-04.webp" loading="lazy" />
    <article>
      <h3>Challenge</h3>
      <p>
        {data.challenge.map((p, i) => (
          <>
            {i > 0 && <><br /><br /></>}
            <span>{p}</span>
          </>
        ))}
      </p>
    </article>

    <img src="/assets/img/interiors/bubelle/media-05.webp" loading="lazy" />
    <img src="/assets/img/interiors/bubelle/media-06.webp" loading="lazy" />

    <article>
      <h3>The Work</h3>
      <p>
        {data.the_work.map((p, i) => (
          <>
            {i > 0 && <><br /><br /></>}
            <span>{p}</span>
          </>
        ))}
      </p>
    </article>

    <video
      src="/assets/img/interiors/bubelle/media-07.mp4"
      preload="none"
      data-lazy-video
      loop
      muted
      playsinline
      class="h-86.5 lg:h-198.5 object-cover object-[0_25%]"
    />
  </div>

  <OtherProyects prev_path="/" next_path="/" />
</section>
