---
import Attributes from "@/components/interiors/Attributes.astro";
import OtherProyects from "@/components/interiors/OtherProyects.astro";
import { getInteriorContent } from "@/i18n/interiors";
import { getLangFromUrl } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const data = getInteriorContent("ratito", lang)!;
---

<section class="max-w-96 mx-auto px-2 lg:container interior">
  <div>
    <h1 class="title">Ratito</h1>

    <video
      src="/assets/img/interiors/ratito/media-01.mp4"
      playsinline
      muted
      autoplay
      loop
      class="h-54 lg:h-212 object-cover"
      preload="none"></video>
  </div>
  <article class="mt-4 lg:mt-26">
    <h2 class="description">{data.description}</h2>
    <Attributes attributes={data.attributes} />
  </article>

  <div class="content">
    <div class="img-container">
      <img
        src="/assets/img/interiors/ratito/media-02.webp"
        class="h-91 lg:h-173 object-cover"
        loading="lazy"
      />
      <img
        src="/assets/img/interiors/ratito/media-03.webp"
        class="h-173 object-cover object-center hidden lg:block"
      />
    </div>

    <article>
      <h3>Context</h3>
      <p>
        {data.context.map((p, i) => (
          <>
            {i > 0 && <><br /><br /></>}
            <span>{p}</span>
          </>
        ))}
      </p>
    </article>

    <img
      src="/assets/img/interiors/ratito/media-03.webp"
      class="h-91 object-cover object-center lg:hidden"
    />
    <img src="/assets/img/interiors/ratito/media-04.webp" loading="lazy" />

    <article>
      <h3>Challenge</h3>
      <p>
        {data.challenge.map((p, i) => (
          <>
            {i > 0 && <><br /><br /></>}
            <span>{p}</span>
          </>
        ))}
      </p>
    </article>

    <div class="img-container">
      <img
        src="/assets/img/interiors/ratito/media-05.webp"
        class="h-107.5 lg:h-216.5 object-cover"
        loading="lazy"
      />
      <img
        src="/assets/img/interiors/ratito/media-06.webp"
        class="h-216.5 object-cover hidden lg:block"
        loading="lazy"
      />
    </div>

    <article>
      <h3>The Work</h3>
      <p>
        {data.the_work.map((p, i) => (
          <>
            {i > 0 && <><br /><br /></>}
            <span>{p}</span>
          </>
        ))}
      </p>
    </article>

    <img
      src="/assets/img/interiors/ratito/media-06.webp"
      class="h-113 object-cover lg:hidden"
      loading="lazy"
    />
    <img
      src="/assets/img/interiors/ratito/media-07.webp"
      loading="lazy"
      class="lg:h-188 object-cover object-[0_60%]"
    />
  </div>

  <OtherProyects prev_path="/" next_path="/" />
</section>
