---
import Attributes from "@/components/interiors/Attributes.astro";
import OtherProyects from "@/components/interiors/OtherProyects.astro";
import { getInteriorContent } from "@/i18n/interiors";
import { getLangFromUrl } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const data = getInteriorContent("meteoro", lang)!;
---

<section class="max-w-96 mx-auto px-2 lg:container interior">
  <div>
    <h1 class="title">Meteoro</h1>

    <video
      src="/assets/img/interiors/meteoro/media-01.webm"
      class="h-54 lg:h-212 object-cover"
      playsinline
      muted
      autoplay
      loop
      preload="none"></video>
  </div>
  <article class="mt-4 lg:mt-26">
    <h2 class="description">{data.description}</h2>
    <Attributes attributes={data.attributes} />
  </article>

  <div class="content">
    <div class="grid-component">
      <img
        src="/assets/img/interiors/meteoro/media-02.webp"
        class="h-91 lg:h-173 object-cover"
        loading="lazy"
      />
      <article class="">
        <h3>Context</h3>
        <p>
          {
            data.context.map((p, i) => (
              <>
                {i > 0 && (
                  <>
                    <br />
                    <br />
                  </>
                )}
                <span>{p}</span>
              </>
            ))
          }
        </p>
      </article>
    </div>

    <div class="grid-component">
      <img
        src="/assets/img/interiors/meteoro/media-03.webp"
        class="h-90 lg:h-173 object-cover object-center lg:hidden"
      />
      <article>
        <h3>Challenge</h3>
        <p>
          {
            data.challenge.map((p, i) => (
              <>
                {i > 0 && (
                  <>
                    <br />
                    <br />
                  </>
                )}
                <span>{p}</span>
              </>
            ))
          }
        </p>
      </article>
      <img
        src="/assets/img/interiors/meteoro/media-03.webp"
        class="h-86 lg:h-173 object-cover object-center hidden lg:block"
      />
    </div>

    <div class="img-container">
      <img
        src="/assets/img/interiors/meteoro/media-04.webp"
        loading="lazy"
        class="lg:h-200 object-cover"
      />
      <img
        src="/assets/img/interiors/meteoro/media-05.webp"
        loading="lazy"
        class="lg:h-200 object-cover hidden lg:block"
      />
    </div>

    <div class="grid-component">
      <article>
        <h3>The Work</h3>
        <p>
          {
            data.the_work.map((p, i) => (
              <>
                {i > 0 && (
                  <>
                    <br />
                    <br />
                  </>
                )}
                <span>{p}</span>
                {i == 1 && (
                  <span>
                    <br />
                    <br />
                    <img
                      src="/assets/img/interiors/meteoro/media-05.webp"
                      loading="lazy"
                      class="lg:h-200 object-cover lg:hidden"
                    />
                  </span>
                )}
              </>
            ))
          }
        </p>
      </article>

      <img
        src="/assets/img/interiors/meteoro/media-06.webp"
        loading="lazy"
        class="lg:h-210 object-cover"
      />
    </div>
  </div>

  <OtherProyects prev_path="/" next_path="/" />
</section>
