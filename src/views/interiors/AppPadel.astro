---
import Attributes from "@/components/interiors/Attributes.astro";
import OtherProyects from "@/components/interiors/OtherProyects.astro";
import { getInteriorContent } from "@/i18n/interiors";
import { getLangFromUrl } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const data = getInteriorContent("apppadel", lang)!;
---

<section class="custom-section px-2 interior">
  <div>
    <h1 class="title">AppPadel</h1>

    <video
      src="/assets/img/interiors/apppadel/media-01.webm"
      class="h-54 lg:h-212 object-cover"
      autoplay
      muted
      loop
      playsinline></video>
  </div>
  <article class="mt-4 lg:mt-26">
    <h2 class="description">{data.description}</h2>
    <Attributes attributes={data.attributes} />
  </article>

  <div class="content">
    <img
      src="/assets/img/interiors/apppadel/media-02.webp"
      loading="lazy"
      class="lg:h-180 object-cover"
    />

    <article>
      <h3>Context</h3>
      <p class="p-02">
        {
          data.context.map((p, i) => (
            <>
              {i > 0 && (
                <>
                  <br />
                  <br />
                </>
              )}
              <span>{p}</span>
            </>
          ))
        }
      </p>
    </article>

    <div class="img-container">
      <img
        src="/assets/img/interiors/apppadel/media-03.webp"
        loading="lazy"
        class="h-96 lg:h-173 object-cover object-right object-size-[110%]"
      />
      <img
        src="/assets/img/interiors/apppadel/media-04.webp"
        loading="lazy"
        class="h-114 lg:h-173 object-cover object-[0_20%] hidden lg:block"
      />
    </div>

    <article>
      <h3>Challenge</h3>
      <p>
        {
          data.challenge.map((p, i) => (
            <>
              {i > 0 && (
                <>
                  <br />
                  <br />
                </>
              )}
              <span>{p}</span>
            </>
          ))
        }
      </p>
    </article>

    <img
      src="/assets/img/interiors/apppadel/media-04.webp"
      loading="lazy"
      class="h-114 lg:h-173 object-cover object-[0_20%] lg:hidden"
    />

    <img
      src="/assets/img/interiors/apppadel/media-05.webp"
      loading="lazy"
      class="object-cover hidden lg:block"
    />

    <article>
      <h3>The Work</h3>
      <div class="grid-p p-02">
        <p class="[&:not(:last-child)]:mb-6!">{data.the_work[0]}</p>
        <img
          src="/assets/img/interiors/apppadel/media-044.webp"
          loading="lazy"
          class="object-cover lg:hidden mb-6"
        />
        <p class="[&:not(:last-child)]:mb-6!">{data.the_work[1]}</p>
        <img
          src="/assets/img/interiors/apppadel/media-05.webp"
          loading="lazy"
          class="object-cover lg:hidden mb-6"
        />
      </div>
    </article>
  </div>

  <OtherProyects currentSlug="app-padel" />
</section>
