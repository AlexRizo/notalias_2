---
import Attributes from "@/components/interiors/Attributes.astro";
import OtherProyects from "@/components/interiors/OtherProyects.astro";
import { getInteriorContent } from "@/i18n/interiors";
import { getLangFromUrl } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const data = getInteriorContent("apppadel", lang)!;
---

<section class="max-w-96 mx-auto px-2 lg:container interior">
  <div>
    <h1 class="title">AppPadel</h1>

    <img
      src="/assets/img/interiors/apppadel/media-01.webp"
      class="h-54 lg:h-212 object-cover"
    />
  </div>
  <article class="mt-4 lg:mt-26">
    <h2 class="description">{data.description}</h2>
    <Attributes attributes={data.attributes} />
  </article>

  <div class="content">
    <img
      src="/assets/img/interiors/apppadel/media-02.webp"
      loading="lazy"
      class="lg:h-180 object-cover"
    />

    <article>
      <h3>Context</h3>
      <p class="p-02">
        {
          data.context.map((p, i) => (
            <>
              {i > 0 && (
                <>
                  <br />
                  <br />
                </>
              )}
              <span>{p}</span>
            </>
          ))
        }
      </p>
    </article>

    <div class="img-container">
      <img
        src="/assets/img/interiors/apppadel/media-03.webp"
        loading="lazy"
        class="lg:h-173 object-cover object-right object-size-[110%]"
      />
      <img
        src="/assets/img/interiors/apppadel/media-04.webp"
        loading="lazy"
        class="h-114 lg:h-173 object-cover"
      />
    </div>

    <article>
      <h3>Challenge</h3>
      <p>
        {
          data.challenge.map((p, i) => (
            <>
              {i > 0 && (
                <>
                  <br />
                  <br />
                </>
              )}
              <span>{p}</span>
            </>
          ))
        }
      </p>
    </article>

    <div class="img-container">
      <img
        src="/assets/img/interiors/apppadel/media-05.webp"
        loading="lazy"
        class="lg:h-173 object-cover"
      />
      <img
        src="/assets/img/interiors/apppadel/media-06.webp"
        loading="lazy"
        class="h-114 lg:h-173 object-cover object-[0_35%] hidden lg:block"
      />
    </div>

    <article>
      <h3>The Work</h3>
      <div class="grid-p p-02">
        <p>
          <span>{data.the_work[0]}<br /><br /></span>
          <span>{data.the_work[1]}<br /><br /></span>
        </p>
        <img
          src="/assets/img/interiors/apppadel/media-06.webp"
          loading="lazy"
          class="h-84 lg:h-173 object-cover lg:hidden mb-6"
        />
        <p>
          <span>{data.the_work[2]}<br /><br /></span>
          <span>{data.the_work[3]}</span>
        </p>
      </div>
    </article>

    <img
      src="/assets/img/interiors/apppadel/media-07.webp"
      loading="lazy"
      class="lg:h-180 object-cover"
    />
  </div>

  <OtherProyects prev_path="/" next_path="/" />
</section>
