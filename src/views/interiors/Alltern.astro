---
import Attributes from "@/components/interiors/Attributes.astro";
import OtherProyects from "@/components/interiors/OtherProyects.astro";
import { getInteriorContent } from "@/i18n/interiors";
import { getLangFromUrl } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const data = getInteriorContent("alltern", lang)!;
---

<section class="custom-section px-2 interior">
  <div>
    <h1 class="title">Alltern</h1>

    <img
      src="/assets/img/interiors/alltern/media-01.webp"
      class="h-54 lg:h-200 object-cover"
      loading="lazy"
    />
  </div>
  <article class="mt-4 lg:mt-26">
    <h2 class="description">{data.description}</h2>
    <Attributes attributes={data.attributes} />
  </article>

  <div class="content">
    <img
      src="/assets/img/interiors/alltern/media-02.webp"
      loading="lazy"
      class="h-100 object-cover lg:hidden"
    />

    <div class="img-container hidden! lg:grid!">
      <img
        src="/assets/img/interiors/alltern/media-02.webp"
        class="h-91 lg:h-173 object-cover"
        loading="lazy"
      />
      <img
        src="/assets/img/interiors/alltern/media-03.webp"
        class="h-91 lg:h-173 object-cover"
        loading="lazy"
      />
    </div>

    <article>
      <h3>Context</h3>
      <p class="p-02">
        {
          data.context.map((p, i) => (
            <>
              {i > 0 && (
                <>
                  <br />
                  <br />
                </>
              )}
              <span>{p}</span>
            </>
          ))
        }
      </p>
    </article>

    <img
      src="/assets/img/interiors/alltern/media-04.webp"
      class="h-91 lg:h-173 object-cover hidden lg:block"
      loading="lazy"
    />

    <img
      src="/assets/img/interiors/alltern/media-03.webp"
      class="object-cover lg:hidden"
      loading="lazy"
    />

    <article>
      <h3>Challenge</h3>
      <p>
        {
          data.challenge.map((p, i) => (
            <>
              {i > 0 && (
                <>
                  <br />
                  <br />
                </>
              )}
              <span>{p}</span>
            </>
          ))
        }
      </p>
    </article>

    <img
      src="/assets/img/interiors/alltern/media-04.webp"
      class="object-cover lg:hidden"
      loading="lazy"
    />

    <div class="hidden lg:block">
      <div class="grid-component">
        <img
          src="/assets/img/interiors/alltern/media-05.webp"
          loading="lazy"
          class="lg:h-188 object-cover object-[0_60%]"
        />
        <img
          src="/assets/img/interiors/alltern/media-06.webp"
          loading="lazy"
          class="lg:h-188 object-cover object-[75%_0]"
        />
      </div>
    </div>

    <article>
      <h3>The Work</h3>
      <div class="grid-p p-02">
        <p class="[&:not(:last-child)]:mb-6!">{data.the_work[0]}</p>
        <img
          src="/assets/img/interiors/alltern/media-06.webp"
          loading="lazy"
          class="h-96 object-cover object-[75%_0] inline-media lg:hidden"
        />
        <p class="[&:not(:last-child)]:mb-6!">{data.the_work[1]}</p>
      </div>
    </article>
    <img
      src="/assets/img/interiors/alltern/media-05.webp"
      loading="lazy"
      class="h-90 object-cover object-[0_45%] lg:hidden"
    />
  </div>
  <OtherProyects currentSlug="alltern" />
</section>
