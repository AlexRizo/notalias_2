---
import Attributes from "@/components/interiors/Attributes.astro";
import OtherProyects from "@/components/interiors/OtherProyects.astro";
import { getInteriorContent } from "@/i18n/interiors";
import { getLangFromUrl } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const data = getInteriorContent("pascal", lang)!;
---

<section class="custom-section px-2 interior">
  <div>
    <h1 class="title">PASCAL</h1>

    <img
      src="/assets/img/interiors/pascal/media-01.webp"
      class="h-54 lg:h-200 object-cover"
      loading="lazy"
    />
  </div>
  <article class="mt-4 lg:mt-26">
    <h2 class="description">{data.description}</h2>
    <Attributes attributes={data.attributes} />
  </article>

  <div class="content">
      <img
        src="/assets/img/interiors/pascal/media-04.webp"
        loading="lazy"
        class="h-106 lg:h-200 object-cover lg:hidden"
      />

      <div class="img-container hidden! lg:grid!">
        <img
          src="/assets/img/interiors/pascal/media-02.webp"
          class="h-91 lg:h-173 object-cover"
          loading="lazy"
        />
        <img
          src="/assets/img/interiors/pascal/media-03.webp"
          class="h-91 lg:h-173 object-cover"
          loading="lazy"
        />
      </div>

      <article>
        <h3>Context</h3>
        <p class="p-02">
          {
            data.context.map((p, i) => (
              <>
                {i > 0 && (
                  <>
                    <br />
                    <br />
                  </>
                )}
                <span>{p}</span>
              </>
            ))
          }
        </p>
      </article>

      <div class="grid-component">
        <img
          src="/assets/img/interiors/pascal/media-03.webp"
          class="h-91 lg:h-173 object-cover lg:hidden"
          loading="lazy"
        />
        <img
          src="/assets/img/interiors/pascal/media-04.webp"
          loading="lazy"
          class="h-86 lg:h-200 object-cover object-center hidden lg:block"
        />
        <article>
          <h3>Challenge</h3>
          <p>
            {
              data.challenge.map((p, i) => (
                <>
                  {i > 0 && (
                    <>
                      <br />
                      <br />
                    </>
                  )}
                  <span>{p}</span>
                </>
              ))
            }
          </p>
        </article>
      </div>

      <img
        src="/assets/img/interiors/pascal/media-05.webp"
        loading="lazy"
        class="lg:h-188 object-cover object-[0_60%] hidden lg:block"
      />

      <img
        src="/assets/img/interiors/pascal/media-02.webp"
        class="h-91 lg:h-173 object-cover lg:hidden"
        loading="lazy"
      />

      <article>
        <h3>The Work</h3>
        <div class="grid-p p-02">
          <p class="[&:not(:last-child)]:mb-6!">{data.the_work[0]}</p>
          <img
            src="/assets/img/interiors/pascal/media-05.webp"
            loading="lazy"
            class="lg:h-188 object-cover object-[0_60%] lg:hidden my-6"
          />
          <p class="[&:not(:last-child)]:mb-6!">{data.the_work[1]}</p>
        </div>
      </article>

      <img
        src="/assets/img/interiors/pascal/media-06.webp"
        loading="lazy"
        class="lg:h-188 object-cover"
      />
    </div>

    <OtherProyects currentSlug="pascal" />
  </div>
</section>
