---
import Droplist from "@/components/droplist/Droplist.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import Layout from "@/layout/Layout.astro";

const lang = getLangFromUrl(Astro.url);
const ui = useTranslations(lang);
---

<Layout lang={lang}>
  <section class="mt-8 max-w-96 mx-auto lg:container">
    <h2
      class="text-[#7B7B7B] text-center font-normal uppercase mt-16 mb-6 lg:text-left text-lg lg:text-xl"
    >
      {ui.services_page.hero_title}
    </h2>
    <div
      class="p-4 h-108.5 max-w-[363px] relative mx-auto overflow-hidden lg:max-w-full lg:h-[664px]"
    >
      <video
        class="rounded-lg h-full object-cover object-[-200px] absolute left-0 top-0 lg:object-center lg:size-full"
        src="/assets/videos/services.mp4"
        preload="none"
        data-lazy-video
        muted
        loop
        playsinline></video>
    </div>
  </section>

  <section class="pt-10 pb-14 lg:pb-24 lg:pt-18">
    <h1
      class="font-arvo text-3xl text-center w-80 mx-auto leading-[1.10] lg:text-6xl lg:w-120 lg:leading-none"
    >
      {ui.services_page.title}
    </h1>
    <img
      src="/assets/icons/jellyfish.svg"
      alt="Medusa"
      class="mx-auto my-10 lg:w-24 lg:my-4"
    />
    <p
      class="text-center w-77 mx-auto font-light leading-tight text-lg lg:text-xl lg:w-[667px]"
    >
      {ui.services_page.description}
    </p>
  </section>

  <section
    class="bg-[#F6F6F6] py-16 lg:py-14 lg:grid lg:grid-cols-2 lg:justify-around lg:items-center lg:gap-2"
  >
    <h1
      class="font-arvo text-3xl text-center lg:text-6xl lg:w-96 lg:ml-auto lg:leading-none lg:text-left"
    >
      {ui.services_page.our_services.title}
    </h1>
    <p
      class="text-lg text-center font-light w-78 mx-auto leading-tight mt-4 lg:text-lg lg:w-[490px] lg:mt-0 lg:text-left lg:mr-auto lg:ml-0"
    >
      {ui.services_page.our_services.description}
    </p>
  </section>

  <section class="max-w-96 mx-auto lg:max-w-full">
    <Droplist />
  </section>

  <section
    class="bg-black flex flex-col justify-center items-center py-18 lg:py-30"
  >
    <img src="/assets/icons/espiral.svg" alt="Spiral" class="lg:w-[105px]" />
    <h1
      class="text-3xl font-arvo text-white text-center w-80 mt-6 mb-8 lg:text-6xl lg:w-150 lg:my-12 leading-[1.10]"
    >
      {ui.services_page.contact.title}
    </h1>
    <a
      href={lang === "en" ? "/en/contact" : "/contacto"}
      class="text-white text-sm flex items-center gap-4 uppercase lg:text-base"
      >{ui.services_page.contact.contact_us}
      <img src="/assets/icons/arrow-white.svg" alt="->" class="lg:w-3" /></a
    >
  </section>
</Layout>
