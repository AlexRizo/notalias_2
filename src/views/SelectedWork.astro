---
import ProjectCard from "@/components/projects/ProjectCard.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const ui = useTranslations(lang);
---

<section class="mb-18 mt-14 lg:mt-21 lg:max-w-[1920px] lg:w-full lg:mx-auto lg:px-8 pb-7 lg:pb-18">
  <h2
    class="text-[#7B7B7B] text-center lg:text-left uppercase mb-6 lg:text-xl"
  >
    {ui.selected_work.title}
  </h2>
  <div
    class="flex flex-col gap-15 lg:grid lg:grid-cols-2 lg:gap-x-3 lg:gap-y-26"
  >
    {
      ui.selected_work.projects.slice(0, 4).map((project) => (
        <ProjectCard
          name={project.name}
          description={project.description}
          url={project.url}
          videoPath={project.video_path}
          button={ui.selected_work.project_button}
        />
      ))
    }
  </div>
</section>
