---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const ui = useTranslations(lang);
---

<section class="max-w-96 lg:container mx-auto">
  <img
    src="/assets/img/home/hero.gif"
    alt="Not Alias"
    class="w-full p-4 lg:hidden"
  />
  <img
    src="/assets/img/home/hero-d.gif"
    alt="Not Alias"
    class="mx-auto hidden lg:block"
  />
  <article class="mt-6 lg:flex lg:flex-row lg:max-w-[1150px] lg:mx-auto">
    <h1
      class="font-arvo text-3xl text-center lg:text-left lg:text-6xl w-76 lg:w-134 mx-auto text-[#060606] lg:tracking-tight"
    >
      {
        ui.home.main_title.map((text, i) => {
          if (i === 1) {
            return (
              <span class="text-[#A0A0A0] italic tracking-tight inline-block lg:min-w-64 min-w-33 text-left ">
                <span id="rotating-word">{text}</span>
                <span id="rotating-cursor" aria-hidden="true">
                  |
                </span>
                {" "}
              </span>
            );
          }
          return <span>{text} </span>;
        })
      }
    </h1>
    <p
      class="text-[#0A0A0A] text-lg lg:text-xl mt-16 lg:mt-0 text-center lg:text-left mx-auto lg:mx-0 lg:ml-auto max-w-67 lg:max-w-106 font-light leading-[1.10] lg:tracking-wider lg:leading-[1.475]"
    >
      {ui.home.description}
    </p>
  </article>
</section>

<script>
  import gsap from "gsap";

  const word = document.getElementById("rotating-word");
  const cursor = document.getElementById("rotating-cursor");

  if (word) {
    const words = ["partner", "director", "team"];
    const state = { count: words[0].length };

    const render = (text: string) => {
      word.textContent = text.slice(0, Math.round(state.count));
    };

    const tl = gsap.timeline({ repeat: -1 });

    words.forEach((current, i) => {
      const next = words[(i + 1) % words.length];
      tl
        // mantener la palabra completa un momento
        .to({}, { duration: 1.6 })
        // borrar la palabra actual
        .to(state, {
          count: 0,
          duration: current.length * 0.05,
          ease: "none",
          onUpdate: () => render(current),
        })
        // escribir la siguiente palabra
        .to(state, {
          count: next.length,
          duration: next.length * 0.09,
          ease: "none",
          onUpdate: () => render(next),
        });
    });
  }

  if (cursor) {
    gsap.to(cursor, {
      opacity: 0,
      duration: 0.5,
      repeat: -1,
      yoyo: true,
      ease: "power2.inOut",
    });
  }
</script>