---
import Paginator from "@/components/paginator/Paginator.astro";
import ProjectCard from "@/components/projects/ProjectCard.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import Layout from "@/layout/Layout.astro";

const lang = getLangFromUrl(Astro.url);
const ui = useTranslations(lang);

const PROJECTS_PER_PAGE = 6;
const projects = ui.selected_work.projects;
const totalPages = Math.ceil(projects.length / PROJECTS_PER_PAGE);
const pageNumbers = Array.from({ length: totalPages }, (_, i) => i + 1);
---

<Layout lang={lang}>
  <section class="lg:container lg:mx-auto lg:px-3">
    <h2
      class="text-[#7B7B7B] text-center font-normal uppercase mt-16 mb-6 lg:text-left text-lg lg:text-xl"
    >
      {ui.selected_work.work_page_title}
    </h2>
    <div
      id="projects-grid"
      class="flex flex-col gap-15 lg:grid lg:grid-cols-2 lg:gap-3 lg:gap-y-22"
    >
      {
        projects.map((project, index) => (
          <div
            data-page={Math.floor(index / PROJECTS_PER_PAGE) + 1}
            class={index >= PROJECTS_PER_PAGE ? "hidden" : ""}
          >
            <ProjectCard
              name={project.name}
              description={project.description}
              url={project.url}
              videoPath={project.video_path}
              button={ui.selected_work.project_button}
            />
          </div>
        ))
      }
    </div>
    {totalPages > 1 && <Paginator pages={pageNumbers} />}
  </section>
  <section
    class="bg-black flex flex-col justify-center items-center pt-10 pb-18 lg:pt-22 lg:pb-30"
  >
    <img src="/assets/icons/ovni-white.svg" alt="Ojo" class="lg:w-37" />
    <h1
      class="text-3xl font-arvo text-white text-center w-71 mt-6 mb-8 lg:mb-10 lg:text-6xl lg:w-[740px] lg:leading-[1.10]"
    >
      {ui.selected_work.contact.title}
    </h1>
    <a class="text-white uppercase flex items-center gap-3"
      >{ui.selected_work.contact.contact_us}<img
        src="/assets/icons/arrow-white.svg"
        alt="->"
        class="lg:w-3"
      /></a
    >
  </section>
</Layout>

<script>
  const PROJECTS_PER_PAGE = 6;

  function goToPage(page: number) {
    document.querySelectorAll<HTMLElement>("[data-page]").forEach((el) => {
      el.classList.toggle("hidden", Number(el.dataset.page) !== page);
    });

    document.querySelectorAll<HTMLElement>("[data-page-btn]").forEach((btn) => {
      btn.classList.toggle("bg-primary", Number(btn.dataset.pageBtn) === page);
    });

    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  document.querySelectorAll<HTMLElement>("[data-page-btn]").forEach((btn) => {
    btn.addEventListener("click", () => goToPage(Number(btn.dataset.pageBtn)));
  });
</script>
