---
import Footer from "@/components/Footer.astro";
import Header from "@/components/navbar/Header.astro";
import { cn } from "@/helpers/cn";
import type { Lang } from "@/i18n/translations";
import "@/styles/global.css";

interface Props {
  lang: Lang;
  title?: string;
  className?: string;
}

const { lang = "es", title, className } = Astro.props;
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Arvo:ital,wght@0,400;0,700;1,400;1,700&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
      rel="stylesheet"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title ? title : "Not Alias_"}</title>
    <script is:inline>
      // Marca que hay JS antes del primer paint para que el fade de los videos
      // se aplique sin flash (y no se oculten si el JS está deshabilitado).
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body class={cn(className)}>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      // Reproduce cada video solo cuando entra en el viewport y lo pausa al
      // salir, para no decodificar todos a la vez (evita saturar GPU/RAM).
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const video = entry.target as HTMLVideoElement;
            if (entry.isIntersecting) {
              if (video.preload === "none") video.preload = "auto";
              video.play().catch(() => {});
            } else {
              video.pause();
            }
          }
        },
        { rootMargin: "200px" },
      );

      // Cada video arranca en opacity: 0 y aparece con fade cuando ya tiene
      // fotograma que mostrar, para que no entre de golpe.
      const revealVideo = (video: HTMLVideoElement) =>
        video.classList.add("video-loaded");

      const setupVideo = (video: HTMLVideoElement) => {
        if (video.dataset.videoReady) return;
        video.dataset.videoReady = "true";

        if (video.readyState >= 2) {
          revealVideo(video);
        } else {
          const onReady = () => revealVideo(video);
          video.addEventListener("loadeddata", onReady, { once: true });
          video.addEventListener("canplay", onReady, { once: true });
          // Si falla la carga, mejor mostrarlo que dejarlo invisible.
          video.addEventListener("error", onReady, { once: true });
        }

        if (video.dataset.lazyVideo !== undefined) observer.observe(video);
      };

      document.querySelectorAll<HTMLVideoElement>("video").forEach(setupVideo);

      // Fade-in de imágenes: misma lógica que los videos.
      const revealImg = (img: HTMLImageElement) =>
        img.classList.add("img-loaded");

      const setupImg = (img: HTMLImageElement) => {
        if (img.dataset.imgReady) return;
        img.dataset.imgReady = "true";

        if (img.complete) {
          revealImg(img);
        } else {
          img.addEventListener("load", () => revealImg(img), { once: true });
          img.addEventListener("error", () => revealImg(img), { once: true });
        }
      };

      document
        .querySelectorAll<HTMLImageElement>("img:not([src$='.svg'])")
        .forEach(setupImg);

      // Los videos/imágenes dentro de islas de React se montan después del script.
      new MutationObserver((mutations) => {
        for (const mutation of mutations) {
          for (const node of mutation.addedNodes) {
            if (!(node instanceof Element)) continue;
            if (node instanceof HTMLVideoElement) setupVideo(node);
            node.querySelectorAll<HTMLVideoElement>("video").forEach(setupVideo);
            if (node instanceof HTMLImageElement && !node.src.endsWith(".svg"))
              setupImg(node);
            node
              .querySelectorAll<HTMLImageElement>("img:not([src$='.svg'])")
              .forEach(setupImg);
          }
        }
      }).observe(document.body, { childList: true, subtree: true });
    </script>
  </body>
</html>
