---
interface Props {
  title: string;
  description: string;
  image: string;
  url: string;
  openLabel: string;
}

const { title, description, image, url, openLabel } = Astro.props as Props;
---

<div class="flex flex-col w-[363px] lg:w-auto lg:h-full">
  <img
    src={image}
    alt={title}
    class="w-full h-111 object-cover rounded-xl lg:h-[557px]"
  />
  <article class="flex flex-col">
    <h1 class="text-2xl my-5.5 lg:text-3xl">{title}</h1>
    <p class="text-lg font-light w-82 leading-tight mb-10 lg:w-auto lg:max-w-96">{description}</p>

    <a class="text-primary flex items-center gap-2 mt-auto" href={url}
      >{openLabel} <img src="/assets/icons/open-external-02.svg" alt="->" class="size-2.5 lg:size-2" /></a
    >
  </article>
</div>
