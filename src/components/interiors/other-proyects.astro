---
import { cn } from "@/helpers/cn";

interface Props {
  prev_path: string;
  next_path: string;
}

const others = [
  {
    video_path: "/assets/img/interiors/nonstop/media-03.mp4",
    name: "Nonstop",
    description:
      "Brand Identity · Brand Execution (Packaging, Brand Applications)",
  },
  {
    video_path: "/assets/videos/swappp.mp4",
    name: "Swappp",
    description:
      "Brand Identity · Brand Execution (Packaging, Brand Applications)",
  },
  {
    video_path: "/assets/videos/manna-foods.mp4",
    name: "Flor y Fruto",
    description:
      "Brand Identity · Brand Execution (Packaging, Brand Applications)",
  },
];

const { prev_path, next_path } = Astro.props;
---

<aside class="grid grid-cols-2 gap-4 mb-16 my-18 px-3 lg:my-30 lg:grid-cols-3 lg:container lg:mx-auto">
  {
    others.map((project, i) => (
      <div class={cn(i === others.length - 1 && "hidden lg:block")}>
        <div class="relative h-[212px] rounded lg:h-[558px]">
          <video
            src={project.video_path}
            autoplay
            muted
            loop
            playsinline
            class="absolute object-cover object-center rounded size-full"
          />
        </div>
        <article class="mb-10">
          <h1 class="text-lg mb-3 mt-5 leading-none lg:text-3xl">
            {project.name}
          </h1>
          <p class="text-sm font-light leading-tight lg:text-lg lg:leading-normal">
            {project.description}
          </p>
        </article>
        {project.name !== "Flor y Fruto" && (
          <a
            href={i === 0 ? prev_path : i === 2 ? next_path : "#"}
            class={cn(
              "flex underline underline-offset-5 text-sm lg:text-[#7B7B7B] lg:text-xl lg:font-light lg:decoration-1 lg:gap-4",
              i && "justify-end",
              i === 0 && "flex-row-reverse justify-end",
            )}
          >
            {i === 0 ? "↖︎ PREVIUS PROJECTS" : "NEXT PROJECTS ↗"}
            {i === 0 ? (
              <img
                src="/assets/icons/gray-arrow.svg"
                alt="<-"
                class="rotate-180 hidden lg:block"
              />
            ) : (
              <img src="/assets/icons/gray-arrow.svg" alt="->" class="hidden lg:block"/>
            )}
          </a>
        )}
      </div>
    ))
  }
</aside>
