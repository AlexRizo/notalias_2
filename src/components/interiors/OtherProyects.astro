---
import { cn } from "@/helpers/cn";

interface Props {
  prev_path: string;
  next_path: string;
}

const others = [
  {
    video_path: "/assets/img/interiors/nonstop/media-03.webm",
    name: "Nonstop",
    description:
      "Brand Identity · Brand Execution (Packaging, Brand Applications)",
  },
  {
    video_path: "/assets/videos/swappp.mp4",
    name: "Swappp",
    description:
      "Brand Identity · Brand Execution (Packaging, Brand Applications)",
  },
  {
    video_path: "/assets/videos/manna-foods.mp4",
    name: "Flor y Fruto",
    description:
      "Brand Identity · Brand Execution (Packaging, Brand Applications)",
  },
];

const { prev_path, next_path } = Astro.props;
---

<section class="mb-16 mt-18 lg:my-30">
  <aside class="grid grid-cols-2 gap-4 lg:grid-cols-3">
    {
      others.map((project, i) => (
        <div class={cn(i === others.length - 1 && "hidden lg:block")}>
          <div class="relative h-[212px] rounded lg:h-[558px]">
            <video
              src={project.video_path}
              preload="none"
              data-lazy-video
              muted
              loop
              playsinline
              class="absolute object-cover object-center rounded size-full"
            />
          </div>
          <article class="mb-10">
            <h1 class="text-lg mb-3 mt-5 leading-none lg:text-3xl font-semibold lg:font-normal">
              {project.name}
            </h1>
            <p class="text-lg font-light leading-tight lg:leading-normal">
              {project.description}
            </p>
          </article>
        </div>
      ))
    }
  </aside>
  <div class="flex justify-between w-full">
    <a
      href={prev_path}
      class={cn(
        "flex text-xs text-primary lg:text-[#7B7B7B] lg:text-xl lg:font-light lg:decoration-1 lg:gap-4 lg:underline underline-offset-8",
      )}
    >
      <img
        src="/assets/icons/gray-arrow.svg"
        alt="<-"
        class="rotate-180 hidden lg:block w-5!"
      />
      <img
        src="/assets/icons/arrow.svg"
        alt="<-"
        class="rotate-180 mr-2 w-3.5! lg:hidden"
      />
      PREVIOUS PROJECTS
    </a>
    <a
      href={next_path}
      class={cn(
        "flex text-xs text-primary lg:text-[#7B7B7B] lg:text-xl lg:font-light lg:decoration-1 lg:gap-4 lg:underline underline-offset-8",
      )}
    >
      NEXT PROJECTS
      <img
        src="/assets/icons/gray-arrow.svg"
        alt="<-"
        class="hidden lg:block w-5!"
      />
      <img src="/assets/icons/arrow.svg" alt="<-" class="ml-2 w-3.5! lg:hidden" />
    </a>
  </div>
</section>
