---
import { cn } from "@/helpers/cn";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import OtherProjectsSlider from "@/components/react/other-projects-slider/other-projects-slider";

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const ui = useTranslations(lang);

const others = ui.selected_work.projects.filter(
  (project) => !project.url.endsWith(`/${currentSlug}`),
);

const prevSelector = "other-projects-prev";
const nextSelector = "other-projects-next";
---

<section class="mb-16 mt-15 lg:my-30">
  <div class="flex justify-between w-full mb-16">
    <button
      type="button"
      class={cn(
        prevSelector,
        "flex cursor-pointer text-xs text-primary lg:text-xl lg:font-light lg:decoration-1 lg:gap-4",
      )}
    >
      <img
        src="/assets/icons/arrow.svg"
        alt="<-"
        class="rotate-180 mr-2 w-3.5!"
      />
      PREVIOUS PROJECTS
    </button>
    <button
      type="button"
      class={cn(
        nextSelector,
        "flex cursor-pointer text-xs text-primary lg:text-xl lg:font-light lg:decoration-1 lg:gap-4",
      )}
    >
      NEXT PROJECTS
      <img src="/assets/icons/arrow.svg" alt="<-" class="ml-2 w-3.5!" />
    </button>
  </div>
  <OtherProjectsSlider
    client:visible
    projects={others}
    prevSelector={`.${prevSelector}`}
    nextSelector={`.${nextSelector}`}
  />
</section>
