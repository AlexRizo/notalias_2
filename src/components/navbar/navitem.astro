---
import { cn } from "@/helpers/cn";

interface Props {
  url: string;
  label: string;
  className?: string;
}

const { url, label, className } = Astro.props;
---

<a
  href={url}
  data-astro-prefetch="hover"
  class={cn(
    "text-white text-lg uppercase tracking-tighter text-center bg-transparent hover:bg-primary transition-colors rounded-2xl py-0.5 lg:text-xs lg:font-medium lg:py-0.75 lg:tracking-wide lg:hover:text-white px-3",
    className,
  )}>{label}</a
>
