---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import ArticleMobile from "./article-mobile.astro";

const lang = getLangFromUrl(Astro.url);
const ui = useTranslations(lang);

const items = ui.about_page.why_notalias.items;
---

<section
  class="scroll-section bg-primary py-20 h-svh flex flex-col items-center justify-evenly border overflow-hidden lg:hidden"
>
  <h1 class="font-arvo text-3xl w-54 mx-auto text-center tracking-tighter">
    {ui.about_page.why_notalias.title[0]}
    {ui.about_page.why_notalias.title[1]}
  </h1>

  <article class="timeline flex items-center self-start overflow-hidden w-max">
    <ArticleMobile title={items[0].title} description={items[0].description} />
    <ArticleMobile title={items[1].title} description={items[1].description} />
    <ArticleMobile title={items[2].title} description={items[2].description} />
    <ArticleMobile title={items[3].title} description={items[3].description} />
    <ArticleMobile title={items[4].title} description={items[4].description} />
  </article>
  <p class="text-center text-lg font-light">
    {ui.about_page.why_notalias.locations}
  </p>
</section>

<script>
import gsap from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";

gsap.registerPlugin(ScrollTrigger);

// Evita que el colapso de la barra de URL dispare refreshes en móvil
ScrollTrigger.config({ ignoreMobileResize: true });

let mm: gsap.MatchMedia | undefined;

const initHorizontalScroll = (): void => {
  mm?.revert();
  mm = gsap.matchMedia();

  // Solo por debajo de lg, que es donde la sección existe
  mm.add("(max-width: 1023px)", () => {
    const section = document.querySelector<HTMLElement>(".scroll-section");
    const timeline = document.querySelector<HTMLElement>(".timeline");
    if (!section || !timeline) return;

    const getDistance = (): number =>
      Math.max(0, timeline.scrollWidth - section.offsetWidth);

    gsap.to(timeline, {
      x: () => -getDistance(),
      ease: "none",
      scrollTrigger: {
        trigger: section,
        pin: true,
        pinType: "transform", // más estable que "fixed" en móvil
        anticipatePin: 1,
        start: "top top",
        end: () => "+=" + getDistance(),
        scrub: 1,
        invalidateOnRefresh: true,
      },
    });
  });
};

document.addEventListener("astro:page-load", () => {
  initHorizontalScroll();

  // Re-medir cuando el layout ya esté estable
  document.fonts?.ready.then(() => ScrollTrigger.refresh());
  window.addEventListener("load", () => ScrollTrigger.refresh(), { once: true });
});

// Limpieza en navegaciones con View Transitions
document.addEventListener("astro:before-swap", () => {
  mm?.revert();
  ScrollTrigger.getAll().forEach((t) => t.kill());
});
</script>
