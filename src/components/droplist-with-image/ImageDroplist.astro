---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
const lang = getLangFromUrl(Astro.url);
const ui = useTranslations(lang);
---

<ul class="border-b border-black/10">
  {
    ui.about_page.how_work.modes.map((item, i) => (
      <li class="accordion-item border-t border-black/10 transition-colors duration-300">
        <div class="lg:container lg:mx-auto lg:pl-25 lg:pr-10">
          <button
            class="accordion-trigger w-full flex justify-between items-center py-7 px-4 text-left lg:py-14"
            aria-expanded="false"
            data-index={i}
          >
            <p class="text-2xl flex items-center gap-7 lg:text-3xl lg:gap-6">
              <span class="w-8 text-center">{"0" + (i + 1)}</span>
              <span class="font-semibold">{item.name}</span>
            </p>

            <p class="accordion-description hidden max-w-84 leading-relaxed lg:block lg:max-w-86">
              {item.description}
            </p>

            <img
              src="/assets/icons/plus-black.svg"
              class="accordion-icon mr-3 w-5 lg:size-[37px]"
              alt="+"
            />
          </button>

          <div class="accordion-description-mobile lg:hidden">
            <p class="pl-19 pr-4 pb-6 leading-relaxed">
              {item.description}
            </p>
          </div>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .accordion-trigger {
    overflow: hidden;
    transition: height 0.4s ease;
  }

  .accordion-description {
    max-height: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .accordion-item.open .accordion-description {
    max-height: none;
    opacity: 1;
    pointer-events: auto;
  }

  .accordion-description-mobile {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transition:
      max-height 0.4s ease,
      opacity 0.3s ease;
  }

  .accordion-item.open .accordion-description-mobile {
    opacity: 1;
    pointer-events: auto;
  }

  .accordion-item.open {
    background-color: var(--color-primary);
  }
</style>

<script>
  const items = document.querySelectorAll<HTMLElement>(".accordion-item");

  // Measure collapsed and expanded heights for each trigger
  items.forEach((item) => {
    const trigger = item.querySelector<HTMLElement>(".accordion-trigger")!;
    const desc = item.querySelector<HTMLElement>(".accordion-description")!;
    const mobileDesc = item.querySelector<HTMLElement>(
      ".accordion-description-mobile"
    )!;

    const expandedH = trigger.scrollHeight;
    const collapsedH = expandedH - desc.scrollHeight;

    trigger.dataset.expandedH = String(expandedH);
    trigger.dataset.collapsedH = String(collapsedH);
    trigger.style.height = collapsedH + "px";

    mobileDesc.dataset.expandedH = String(mobileDesc.scrollHeight);
  });

  const closeItem = (item: HTMLElement) => {
    const trigger = item.querySelector<HTMLElement>(".accordion-trigger")!;
    const icon = item.querySelector<HTMLImageElement>(".accordion-icon")!;
    const mobileDesc = item.querySelector<HTMLElement>(
      ".accordion-description-mobile"
    )!;

    trigger.style.height = trigger.dataset.collapsedH + "px";
    mobileDesc.style.maxHeight = "0px";
    icon.src = "/assets/icons/plus-black.svg";
    icon.alt = "+";
    trigger.setAttribute("aria-expanded", "false");
    item.classList.remove("open");
  };

  items.forEach((item) => {
    const trigger = item.querySelector<HTMLElement>(".accordion-trigger")!;
    const icon = trigger.querySelector<HTMLImageElement>(".accordion-icon")!;
    const mobileDesc = item.querySelector<HTMLElement>(
      ".accordion-description-mobile"
    )!;

    trigger.addEventListener("click", () => {
      const isOpen = trigger.getAttribute("aria-expanded") === "true";

      if (isOpen) {
        closeItem(item);
      } else {
        items.forEach((other) => {
          if (other !== item && other.classList.contains("open")) {
            closeItem(other);
          }
        });

        trigger.style.height = trigger.dataset.expandedH + "px";
        mobileDesc.style.maxHeight = mobileDesc.dataset.expandedH + "px";
        icon.src = "/assets/icons/minus.svg";
        icon.alt = "-";
        trigger.setAttribute("aria-expanded", "true");
        item.classList.add("open");
      }
    });
  });
</script>
