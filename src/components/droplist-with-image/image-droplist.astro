---
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
const lang = getLangFromUrl(Astro.url);
const ui = useTranslations(lang);
---

<ul>
  {
    ui.about_page.how_work.modes.map((item, i) => (
      <li class="accordion-item border-t border-black/10 transition-colors duration-300">
        <div class="lg:container lg:mx-auto lg:pl-25 lg:pr-10">
          <button
            class="accordion-trigger w-full flex justify-between items-center py-3 px-2 text-left lg:py-7"
            aria-expanded="false"
            data-index={i}
          >
            <p class="text-sm flex items-center gap-2 lg:text-3xl lg:gap-6">
              <span class="w-8 text-center">{"0" + (i + 1)}</span> {item.name}
            </p>
            <img
              src="/assets/icons/plus-black.svg"
              class="accordion-icon mr-3 lg:size-[37px]"
              alt="+"
            />
          </button>
          <article class="accordion-content overflow-hidden max-h-0 transition-[max-height] duration-300 ease-in-out text-[10px] flex flex-row justify-between gap-4 lg:text-lg">
            <p class="pl-12 mb-5 max-w-40 leading-relaxed text-white lg:max-w-86 lg:pl-16">
              {item.description}
            </p>
            <img
              src={item.image_path}
              alt={item.name}
              class="w-48 min-h-32 object-cover rounded mb-6 mr-4 lg:w-[725px] lg:min-h-none lg:h-[476px]"
            />
          </article>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .accordion-item.open {
    background-color: var(--color-primary);
  }
  .accordion-item.open .accordion-trigger {
    color: white;
  }
  .accordion-item.open {
    color: rgba(255, 255, 255, 0.75);
  }
  .accordion-item.open .accordion-icon {
    filter: brightness(0) invert(1);
  }
</style>

<script>
  const closeItem = (item: Element) => {
    const content = item.querySelector(".accordion-content") as HTMLElement;
    const trigger = item.querySelector(".accordion-trigger") as HTMLElement;
    const icon = item.querySelector(".accordion-icon") as HTMLImageElement;

    content.style.maxHeight = "0px";
    icon.src = "/assets/icons/plus-black.svg";
    icon.alt = "+";
    trigger.setAttribute("aria-expanded", "false");
    item.classList.remove("open");
  };

  const triggers = document.querySelectorAll(".accordion-trigger");

  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const item = trigger.closest(".accordion-item")!;
      const content = item.querySelector(".accordion-content") as HTMLElement;
      const icon = trigger.querySelector(".accordion-icon") as HTMLImageElement;
      const isOpen = trigger.getAttribute("aria-expanded") === "true";

      if (isOpen) {
        closeItem(item);
      } else {
        triggers.forEach((other) => {
          const otherItem = other.closest(".accordion-item")!;
          if (otherItem !== item && otherItem.classList.contains("open")) {
            closeItem(otherItem);
          }
        });

        content.style.maxHeight = content.scrollHeight + "px";
        icon.src = "/assets/icons/minus.svg";
        icon.alt = "-";
        trigger.setAttribute("aria-expanded", "true");
        item.classList.add("open");
      }
    });
  });
</script>
