---
import Attributes from "@/components/interiors/attributes.astro";
import type { Attributes as AttributesType } from "@/i18n/interiors";
import OtherProyects from "@/components/interiors/other-proyects.astro";
import { getLangFromUrl, useInteriorTranslations } from "@/i18n/utils";
import Layout from "@/layout/layout.astro";

const lang = getLangFromUrl(Astro.url);
const [eterno_centinela] = useInteriorTranslations(lang);

const attributes: AttributesType[] = [
  {
    label: "Client",
    value: ["Grupo AGR", "Bubelle"],
  },
  {
    label: "Services",
    value: ["Naming", "Brand Identity", "Packaging"],
  },
  {
    label: "Industry",
    value: ["Bevarages / Bebida sin alcohol"],
  },
];
---

<Layout lang={lang} className="bg-[#f6f6f6]">
  <section class="max-w-96 mx-auto px-2 lg:container">
    <div>
      <h1 class="text-center text-xl my-6 lg:text-3xl">Eterno Centinela</h1>
      {
        eterno_centinela.hero_path.split(".").at(-1)?.includes("mp4") ? (
          <video
            src={eterno_centinela.hero_path}
            autoplay
            loop
            muted
            playsinline
            class="object-cover"
          />
        ) : (
          <img
            src="/assets/img/interiors/eterno-centinela/mobile/media-01.webp"
            alt={eterno_centinela.title}
            class="w-full"
          />
        )
      }
    </div>

    <article class="mt-4 lg:mt-26">
      <h2
        class="font-arvo text-3xl tracking-tight leading-[1.10] lg:text-4xl lg:max-w-[569px]"
      >
        {eterno_centinela.description}
      </h2>
      <Attributes attributes={eterno_centinela.attributes} />
    </article>

    <div class="content">
      <div class="lg:grid lg:grid-cols-2 lg:gap-4">
        <video
          class="rounded my-6 hidden lg:block lg:my-0 lg:max-h-[845px] lg:mx-auto"
          autoplay
          loop
          muted
          playsinline
          src="/assets/img/interiors/eterno-centinela/media-03.mp4"></video>
        <img
          src="/assets/img/interiors/eterno-centinela/mobile/media-02.webp"
          class="lg:max-h-[845px] lg:mx-auto"
        />
      </div>
      <article class="lg:my-38">
        <h1>Context</h1>
        <p>
          Tequila Centinela tiene 120 años de historia. Eterno es su entrada al
          cristalino — la categoría que hoy define el crecimiento del tequila
          premium. El mercado estaba saturado de marcas gritando legado,
          tradición y herencia. Pero la generación que hoy impulsa el consumo ya
          no compraba discursos de historia — pedía significado, presencia,
          pertenencia a un momento.
        </p>
      </article>

      <video
        class="rounded my-6 lg:hidden"
        autoplay
        loop
        muted
        playsinline
        src="/assets/img/interiors/eterno-centinela/media-03.mp4"></video>

      <img
        src="/assets/img/interiors/eterno-centinela/media-04.webp"
        class="lg:w-full"
      />

      <article class="lg:my-38">
        <h1>Challenge</h1>
        <p>
          La marca existía pero con presencia mínima y sin una identidad que
          levantara la mano en premium. El reto no era contar la historia otra
          vez — era encontrar el territorio donde pudiera vivir hoy, sin
          disfrazarse de juventud ni renunciar a lo que ya era.
        </p>
      </article>

      <div class="lg:grid lg:grid-cols-2 lg:gap-4">
        <img
          src="/assets/img/interiors/eterno-centinela/media-05.webp"
          class="my-6 lg:my-0 lg:max-h-[845px] lg:mx-auto"
        />

        <img
          src="/assets/img/interiors/eterno-centinela/media-06.webp"
          class="my-6 lg:my-0 hidden lg:block lg:max-h-[845px] lg:mx-auto"
        />
      </div>

      <article class="lg:my-38">
        <h1>The Work</h1>
        <p class="lg:flex lg:gap-3 lg:items-start lg:justify-center lg:max-w-none! lg:text-left!">
          <span class="lg:max-w-[429px] lg:ml-12"
            >Ese territorio era la noche. Leímos el high energy y la nightlife
            no como canal de activación, sino como el lugar donde Eterno tenía
            que existir culturalmente. De ahí nació "SOMOS TIEMPO" — un concepto
            que ancla el peso del legado en la energía del ahora, en el momento,
            en la cultura nocturna.</span
          >
          <br class="lg:hidden" /><br class="lg:hidden" />
          <span class="tracking-tighter lg:max-w-[470px] lg:tracking-normal"
            >El sistema visual se construyó desde el entorno, no desde la
            botella. Cristales, metal, luz. El rojo como pulso. Un lenguaje que
            no describe la noche — la habita. Todo materializado en un Creative
            Book ejecutable desde el día uno.</span
          >
        </p>
      </article>

      <img
        src="/assets/img/interiors/eterno-centinela/media-06.webp"
        class="my-6 lg:hidden"
      />
      <img
        src="/assets/img/interiors/eterno-centinela/media-07.webp"
        class="my-6 lg:w-full"
      />
    </div>
  </section>

  <OtherProyects prev_path="/" next_path="/" />
</Layout>

<style>
  @reference "@/styles/global.css";

  img,
  video {
    @apply rounded;
  }

  .content h1 {
    @apply text-lg mt-6 mb-2 lg:text-center lg:text-3xl lg:mb-6 lg:font-light;
  }

  .content p {
    @apply text-sm font-light tracking-tight leading-tight lg:text-lg lg:text-center lg:max-w-[540px] lg:mx-auto lg:font-light;
  }
</style>
