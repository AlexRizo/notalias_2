---
import Layout from "@/layout/layout.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import AboutCarrousel from "@/components/react/about-carrousel/about-carrousel";
import ImageDroplist from "@/components/droplist-with-image/image-droplist.astro";
import { TeamSlider } from "@/components/react/team-slider/team-slider";
import WhyNotalias from "@/views/about/why-notalias.astro";
const lang = getLangFromUrl(Astro.url);
const ui = useTranslations(lang);
---

<Layout lang={lang} className="bg-[#F6F6F6]">
  <section class="pt-4 pb-24 lg:container lg:mx-auto lg:pt-24 lg:px-40">
    <article
      class="text-center lg:text-left lg:flex lg:flex-row lg:justify-between"
    >
      <h1
        class="font-arvo text-3xl w-56 mx-auto leading-tight lg:w-68 lg:mx-0 lg:text-6xl tracking-tight"
      >
        {ui.about_page.hero.title}
      </h1>
      <img
        src="/assets/img/about/head-brain.gif"
        class="h-25 mx-auto mt-16 mb-12 lg:h-[236px] lg:my-0"
        alt="about"
      />
      <div class="font-light text-sm leading-tight lg:text-xl">
        <p class="w-38 mx-auto lg:w-96 lg:mx-0">
          {ui.about_page.hero.description[0]}
        </p>
        <p class="w-42 mx-auto lg:w-96 lg:mx-0">
          {ui.about_page.hero.description[1]}
        </p>
      </div>
    </article>
  </section>

  <section>
    <AboutCarrousel client:visible slides={ui.about_page.slide.slides} />
  </section>

  <section class="text-center py-8 lg:py-6">
    <h1 class="font-arvo text-3xl w-56 mx-auto leading-tight lg:text-6xl lg:w-auto">
      {ui.about_page.how_work.title}
    </h1>
  </section>

  <section class="max-w-96 mx-auto lg:max-w-none">
    <ImageDroplist />
  </section>

  <TeamSlider
    client:visible
    title={ui.about_page.team.title}
    slides={ui.about_page.team.slides}
  />

  <WhyNotalias />

  <section class="flex flex-col justify-center items-center p-20">
    <img src="/assets/icons/work-together.svg" alt="Spiral" class="lg:w-[193px]"/>
    <h1 class="text-3xl font-arvo text-center w-60 mt-5 mb-6 lg:text-[55px] lg:w-auto">
      {ui.about_page.work_together.title}
    </h1>
    <a class="text-sm uppercase lg:text-base"
      >{ui.about_page.work_together.contact_us}</a
    >
  </section>
</Layout>
